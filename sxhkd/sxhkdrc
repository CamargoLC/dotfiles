# ==========================================
# GATILHOS DO SISTEMA E APLICATIVOS
# ==========================================

# Emulador de Terminal
super + Return
    alacritty

# Lançador de Aplicativos (Rofi)
super + r
    rofi -show drun

# Menu de Energia (Power Menu)
super + shift + e
    /mnt/meu_hd/dotfiles/rofi/powermenu.sh

# Reiniciar o bspwm / Sair do bspwm
super + alt + {r,q}
    bspc {wm -r,quit}

# Recarregar as configurações de atalho (sxhkd)
super + Escape
    pkill -USR1 -x sxhkd

# ==========================================
# DUNST NOTIFICATIONS
# ==========================================

# Data e Hora
super + d
    /mnt/meu_hd/dotfiles/scripts/hora.sh

# Uso de CPU e RAM
super + i
    /mnt/meu_hd/dotfiles/scripts/sys_info.sh

# Status da Bateria
super + b
    /mnt/meu_hd/dotfiles/scripts/bateria.sh

# Dispensar notificação imediatamente
super + n
    dunstctl close

# ==========================================
# HARDWARE (ÁUDIO E BRILHO)
# ==========================================

# Aumentar Volume (Fn + Seta Acima)
XF86AudioRaiseVolume
    /mnt/meu_hd/dotfiles/scripts/vol_up.sh

# Diminuir Volume (Fn + Seta Abaixo)
XF86AudioLowerVolume
    /mnt/meu_hd/dotfiles/scripts/vol_down.sh

# Mutar Volume
XF86AudioMute
    pactl set-sink-mute @DEFAULT_SINK@ toggle

# Brilho da Tela
XF86MonBrightness{Up,Down}
    brightnessctl set {+5%,5%-}

# ==========================================
# GERENCIAMENTO DE JANELAS
# ==========================================

# Fechar (w) ou Matar a janela à força (shift + w)
super + {_,shift + }w
    bspc node -{c,k}

# Alternar estados (Tiled, Pseudo-tiled, Floating, Fullscreen)
super + {t,shift + t,s,f,shift + space}
    bspc node -t {tiled,pseudo_tiled,floating,fullscreen,"~"floating}

# Layout Monocle (Maximizado) / Focar na maior janela
super + {m,g}
    {bspc desktop -l next,bspc node -s biggest.window}

# Flags de janela (Marked, Locked, Sticky, Private)
super + ctrl + {m,x,y,z}
    bspc node -g {marked,locked,sticky,private}

# Focar ou mover janela na direção (H J K L)
super + {_,shift + }{h,j,k,l}
    bspc node -{f,s} {west,south,north,east}

# Focar ou mover janela para as Áreas de Trabalho (1-0)
super + {_,shift + }{1-9,0}
    bspc {desktop -f,node -d} '^{1-9,10}'

# Focar em janelas relativas 
super + {_,shift + }c
    bspc node -f {next,prev}.local.!hidden.window
    
super + {p,b,comma,period}
    bspc node -f @{parent,brother,first,second}

# Alternar Áreas de Trabalho e Histórico
super + bracket{left,right}
    bspc desktop -f {prev,next}.local

super + {grave,Tab}
    bspc {node,desktop} -f last

# Direção e Proporção (Ratio)
super + ctrl + {h,j,k,l}
    bspc node -p {west,south,north,east}

super + ctrl + {1-9}
    bspc node -o 0.{1-9}

# Cancelar pré-seleção
super + ctrl + {_,shift + }space
    {bspc node -p cancel,bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel}

# Expandir Janelas
super + alt + {h,j,k,l}
    bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# Contrair Janelas
super + alt + shift + {h,j,k,l}
    bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# Mover janela flutuante com as setas
super + {Left,Down,Up,Right}
    bspc node -v {-20 0,0 20,0 -20,20 0}

# ==========================================
# CAPTURA DE TELA (FLAMESHOT)
# ==========================================

# Print tela inteira
Print
    flameshot full -p /mnt/meu_hd/Screenshots && sleep 1 && pkill -x flameshot

# Print com interface de seleção (recorte guiado)
shift + Print
    flameshot gui
