/* Non-minimalist Rofi configuration for Void Linux */
* {
    font: "Figtree 13";
    bg-color: #000000FF;
    fg-color: #FFFFFFFF;
    accent-color: #b8bb26FF; /* Green accent */
    wbg-color: #000000CC; /* Window background */
    item-bg: #1d2021FF; /* Normal items bg */
    alt-bg: #282828FF; /* Alternate items bg */
    sel-bg: #b8bb26FF; /* Selected item green bg */
    sel-fg: #1d2021FF; /* Selected item dark fg */
    b-radius: 8px;
    g-spacing: 12px; /* Increased gaps */
    w-border: 2px solid; /* Thicker borders */
    w-border-color: #b8bb26FF; /* Accent border color */
    w-padding: 16px;
    w-transparency: "real";
}

configuration {
    modi: "drun";
    show-icons: true;
    display-drun: "";
}

window {
    transparency: @w-transparency;
    width: 450px;
    border-radius: @b-radius;
    background-color: @wbg-color;
    border: @w-border;
    border-color: @w-border-color;
    padding: @w-padding;
}

inputbar {
    children: ["prompt", "entry"];
    spacing: 12px;
    background-color: #1a1a1aFF; /* Dark grey for inputbar */
    border: 2px solid;
    border-color: #b8bb26FF;
    border-radius: 8px;
    padding: 12px;
}

mainbox {
    spacing: 12px;
    padding: 10px;
    children: ["inputbar", "listview", "message"];
}

listview {
    columns: 1;
    lines: 7;
    fixed-height: true;
    fixed-columns: true;
    cycle: false;
    scrollbar: false;
    spacing: 12px;
    border: 0px solid;
}

element {
    spacing: 12px;
    padding: 12px;
    border: 1px solid;
    border-color: #282828FF; /* Grey border for items */
    border-radius: 8px;
    background-color: #1a1a1aFF; /* Default grey bg */
    text-color: #FFFFFFFF;
}

element normal.normal {
    background-color: transparent;
    text-color: #FFFFFFFF;
}

element alternate.normal {
    background-color: #282828FF; /* Solid bg for alternate */
    text-color: #FFFFFFFF;
}

element selected.active, element selected.normal {
    background-color: #b8bb26FF; /* Rich green background */
    text-color: #1d2021FF; /* Dark contrasting text */
    border-color: #FFFFFFFF; /* White inner border for highlight */
}

message {
    background-color: red;
    border: 0px solid;
}

prompt {
    text-color: #FFFFFFFF;
}

entry {
    text-color: #FFFFFFFF;
    placeholder: "Search Apps";
    placeholder-color: #888888FF;
}
