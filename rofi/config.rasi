configuration {
    modi: "drun,run";
    show-icons: true;
    font: "JetBrainsMono Nerd Font 10";
    display-drun: "Apps";
    drun-display-format: "{name}";
}

* {
    /* Paleta Nord */
    bg0: #2E3440;
    bg1: #3B4252;
    fg0: #ECEFF4;
    accent: #88C0D0;

    background-color: transparent;
    text-color: @fg0;
    margin: 0;
    padding: 0;
}

window {
    width: 300px;
    background-color: @bg0;
    border: 3px solid;
    border-color: @accent;
    border-radius: 9px;
    padding: 10px;
}

mainbox {
    children: [inputbar, listview];
}

inputbar {
    background-color: @bg1;
    border-radius: 5px;
    padding: 8px;
    children: [prompt, entry];
}

prompt {
    text-color: @accent;
    padding: 0 8px 0 0;
}

entry {
    placeholder: "Buscar...";
    placeholder-color: #4C566A;
}

listview {
    lines: 6;
    padding: 10px 0 0 0;
}

element {
    padding: 8px;
    border-radius: 5px;
}

element selected {
    background-color: @bg1;
    text-color: @accent;
}

element-icon {
    size: 25px;
    padding: 0 10px 0 0;
}
