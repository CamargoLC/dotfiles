{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "void2_small",
        "color": {
            "1": "blue"
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "cyan"
        },
        "size": {
            "ndigits": 2,
            "maxPrefix": "GB"
        },
        "key": {
            "type": "icon"
        }
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "cyan",
                "at": "white",
                "host": "blue"
            }
        },
        "os",
        "kernel",
        "wm",
        "packages",
        "uptime",
        "disk",
        "memory"
    ]
}
