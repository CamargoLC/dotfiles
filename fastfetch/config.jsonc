{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "void2_small",
    "color": {
      "1": "green"
    },
    "padding": {
      "top": 2,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "custom",
      "format": "─────── Information ───────"
    },
    {
      "type": "os",
      "key": "OS    ",
      "keyColor": "green",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "green",
      "format": "{2}"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "green"
    },
    {
      "type": "wm",
      "key": "WM    ",
      "keyColor": "green",
      "format": "{1}"
    },
    {
      "type": "shell",
      "key": "Shell ",
      "keyColor": "green",
      "format": "{1}"
    },
    {
      "type": "terminal",
      "key": "Term  ",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": "Pkgs  ",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "Disk  ",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "───────────────────────────"
    }
  ]
}
